# ==============================================================================
# CONFIGURACION GLOBAL SGI-MONOLITHE (DOCKER & SUPABASE)
# Copia este archivo como .env y completa con tus valores reales. No subir .env al repositorio.
# ==============================================================================

# Supabase API (Frontend y funciones cliente)
VITE_SUPABASE_URL=https://<TU-PROJECT-ID>.supabase.co
VITE_SUPABASE_ANON_KEY=<TU-ANON-KEY>

# Supabase PostgreSQL Database (Backend auth-service y PaginaWeb backend via Pooler)
SUPABASE_DB_URL=jdbc:postgresql://<HOST-POOLER>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<TU-PROJECT-ID>
SUPABASE_DB_PASSWORD=<TU-DB-PASSWORD>

# Auth Service
AUTH_SERVICE_PORT=8081
VITE_AUTH_API_URL=http://localhost:8081/api/auth

# PaginaWeb (CMS & Web Publica)
WEB_BACKEND_PORT=8082
VITE_WEB_API_URL=http://localhost:8082

# Claves RSA locales del auth-service (rutas del HOST)
JWT_PRIVATE_KEY_PATH_HOST=./.secret/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH_HOST=./.secret/keys/jwt-public.pem

# Correo (Desarrollo local / Mailpit / SMTP)
MAIL_FROM=no-reply@monolithe.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dummy
MAIL_PASSWORD=dummy
