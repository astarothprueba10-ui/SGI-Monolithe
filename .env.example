# Configuracion local de ejemplo para SGI MONOLITHE
# Copia este archivo como .env y completa los valores reales. No lo subas al repositorio.

SUPABASE_DB_URL=jdbc:postgresql://<SESSION-POOLER-HOST>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<PROJECT-REF>
SUPABASE_DB_PASSWORD=<DB-PASSWORD>

AUTH_SERVICE_PORT=8081
VITE_AUTH_API_URL=http://localhost:8081/api/auth

# Claves RSA locales del auth-service (rutas del HOST)
JWT_PRIVATE_KEY_PATH_HOST=C:/SGI-Monolithe-Secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH_HOST=C:/SGI-Monolithe-Secrets/jwt-public.pem

# Correo
MAIL_FROM=no-reply@monolithe.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dummy
MAIL_PASSWORD=dummy

# Supabase desde navegador: solo si una funcion futura lo requiere y con RLS configurado.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
