# ==============================================================================
# SGI-MONOLITHE -- PLANTILLA DE VARIABLES DE ENTORNO
# ==============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo como .env en la raiz del proyecto:
#        cp .env.example .env
#   2. Completa los valores reales que te envio el lider por canal privado.
#   3. NUNCA subas el archivo .env a Git (ya esta en .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Credentials (Obtener del Dashboard > Settings > API)
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_REF=<TU-PROJECT-REF>
SUPABASE_URL=https://<TU-PROJECT-REF>.supabase.co
SUPABASE_ANON_KEY=<TU-ANON-KEY>
SUPABASE_PUBLISHABLE_KEY=<TU-PUBLISHABLE-KEY>

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database (Conexion directa)
# ------------------------------------------------------------------------------
SUPABASE_DB_HOST=db.<TU-PROJECT-REF>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=<TU-DB-PASSWORD>

# ------------------------------------------------------------------------------
# Supabase JDBC Pooler (Spring Boot Backend)
# Obtener de Dashboard > Settings > Database > Connection Pooling
# ------------------------------------------------------------------------------
SUPABASE_DB_URL=jdbc:postgresql://<HOST-POOLER>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<TU-PROJECT-REF>

# ------------------------------------------------------------------------------
# Frontend Vite Variables
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<TU-PROJECT-REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<TU-ANON-KEY>
VITE_API_URL=http://localhost:8082
VITE_AUTH_API_URL=http://localhost:8081/api/auth

# ------------------------------------------------------------------------------
# Puertos locales (valores por defecto, no requieren cambio)
# ------------------------------------------------------------------------------
AUTH_SERVICE_PORT=8081
WEB_BACKEND_PORT=8082
WEB_FRONTEND_PORT=5175

# CORS - Orígenes permitidos para los frontends
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,
http://192.168.1.7:5173,http://192.168.1.7:5174,http://192.168.1.7:5175

# ------------------------------------------------------------------------------
# Claves RSA (se generan automaticamente con iniciar_local.sh)
# ------------------------------------------------------------------------------
JWT_PRIVATE_KEY_PATH_HOST=./.secret/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH_HOST=./.secret/keys/jwt-public.pem

# ------------------------------------------------------------------------------
# Correo (Desarrollo local / Mailpit / SMTP)
# ------------------------------------------------------------------------------
MAIL_FROM=no-reply@monolithe.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dummy
MAIL_PASSWORD=dummy

# ------------------------------------------------------------------------------
# Supabase Storage - SOLO BACKEND
# ------------------------------------------------------------------------------

# Clave privada con permisos elevados para administrar Supabase Storage.
# Solo debe ser utilizada por cms-service.
# NUNCA usar esta clave en React, variables VITE_* ni subirla al repositorio.
SUPABASE_SERVICE_ROLE_KEY=<TU-SERVICE-ROLE-KEY>

# Bucket destinado a los archivos públicos del CMS:
# imágenes, videos y documentos de la página web.
CMS_STORAGE_BUCKET=cms-public