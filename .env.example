# ==============================================================================
# CONFIGURACION GLOBAL SGI-MONOLITHE (DOCKER & SUPABASE)
# Copia este archivo como .env y completa los valores reales. No lo subas al repositorio.
# ==============================================================================

# Supabase API (Frontend y funciones cliente)
VITE_SUPABASE_URL=https://REDACTED_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=REDACTED_ANON_KEY

# Supabase PostgreSQL Database (Backend auth-service via Pooler)
SUPABASE_DB_URL=jdbc:postgresql://REDACTED_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.REDACTED_PROJECT_REF
SUPABASE_DB_PASSWORD=<DB-PASSWORD>

# Auth Service
AUTH_SERVICE_PORT=8081
VITE_AUTH_API_URL=http://localhost:8081/api/auth

# Claves RSA locales del auth-service (rutas del HOST)
JWT_PRIVATE_KEY_PATH_HOST=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH_HOST=./secrets/jwt-public.pem

# Correo (Desarrollo local / Mailpit / SMTP)
MAIL_FROM=no-reply@monolithe.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dummy
MAIL_PASSWORD=dummy
