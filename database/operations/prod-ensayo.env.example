# Plantilla de configuracion de ensayo. Copiar a .secret/prod-ensayo/connection.env.
# NO incluir valores reales en Git, en mensajes ni en capturas.
# Las tres identidades JDBC deben ser aprovisionadas y verificadas por el administrador.
# Los usuarios del pooler deben corresponder al proyecto ljxbkfvtbbucakkvdzmr.
# No usar postgres como identidad habitual del aplicativo.
PROD_ENSAYO_AUTH_DB_USERNAME=
PROD_ENSAYO_AUTH_DB_PASSWORD=
PROD_ENSAYO_CORE_DB_USERNAME=
PROD_ENSAYO_CORE_DB_PASSWORD=
PROD_ENSAYO_CMS_DB_USERNAME=
PROD_ENSAYO_CMS_DB_PASSWORD=
# Clave publica del nuevo proyecto (no clave de servicio).
PROD_ENSAYO_PUBLIC_KEY=
# Clave de Storage exclusiva de los backends, nunca de Vite.
PROD_ENSAYO_STORAGE_KEY=
