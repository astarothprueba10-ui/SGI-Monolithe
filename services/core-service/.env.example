# ============================================================
# SGI MONOLITHE - CORE SERVICE
# Archivo de ejemplo de variables de entorno
# Copiar como .env y reemplazar los valores necesarios.
# NO subir credenciales reales al repositorio.
# ============================================================


# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------

SERVER_PORT=8083


# ------------------------------------------------------------
# BASE DE DATOS - SUPABASE POSTGRESQL
# ------------------------------------------------------------
# Utilizar la cadena JDBC correspondiente al Session Pooler
# de Supabase.
#
# Ejemplo:
# jdbc:postgresql://<HOST_POOLER>:5432/postgres?sslmode=require

DB_URL=jdbc:postgresql://<SUPABASE_POOLER_HOST>:5432/postgres?sslmode=require

# Usuario proporcionado por Supabase para el pooler.
DB_USERNAME=<SUPABASE_DB_USERNAME>

# Contraseña de la base de datos.
DB_PASSWORD=<SUPABASE_DB_PASSWORD>


# ------------------------------------------------------------
# JWT - AUTH SERVICE
# ------------------------------------------------------------
# core-service solo necesita la CLAVE PUBLICA.
# La clave privada pertenece exclusivamente a auth-service.
#
# Ejecución local desde services/core-service:
JWT_PUBLIC_KEY_PATH=../../.secret/keys/jwt-public.pem

# En Docker Compose normalmente se monta como:
# /run/secrets/jwt-public.pem


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Orígenes permitidos separados por coma.
#
# 5173 -> Portal cliente
# 5174 -> Backoffice
# 5175 -> Página web
# 3000 -> Desarrollo alternativo

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000