# Puerto del Backend de PaginaWeb (CMS)
SERVER_PORT=8082

# Conexión Supabase PostgreSQL Database (Session Pooler puerto 5432 o Transaction Pooler 6543)
DB_URL=jdbc:postgresql://<HOST-POOLER>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<TU-PROJECT-ID>
DB_PASSWORD=<TU-DB-PASSWORD>

# Clave pública JWT para validar tokens del auth-service
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
