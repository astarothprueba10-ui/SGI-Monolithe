# Desarrollo local: el navegador utiliza el proxy same-origin de Vite.
# En Docker Compose, los proxy targets los define docker-compose.yml.
VITE_CORE_API_URL=/api/core
CORE_PROXY_TARGET=http://localhost:8083

VITE_AUTH_API_URL=/api/auth
AUTH_PROXY_TARGET=http://localhost:8081

# En Vercel/producción, reemplazar VITE_CORE_API_URL y VITE_AUTH_API_URL
# por URLs HTTPS reales de los servicios (o configurar rewrites efectivos).
# No publicar rutas /api/core o /api/auth que respondan index.html.
# Verificar CORS del backend cuando se usan orígenes distintos.

# Supabase: solo URL y clave pública en el frontend.
VITE_SUPABASE_URL=https://<TU-PROJECT-ID>.supabase.co
VITE_SUPABASE_ANON_KEY=<TU-CLAVE-PUBLICA>

# NUNCA colocar SUPABASE_SECRET_KEY ni SERVICE_ROLE_KEY en variables VITE_.
