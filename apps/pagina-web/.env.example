# URL del Microservicio Backend de la Pagina Web (CMS & Public API)
VITE_API_URL=http://localhost:8082

# URL del Microservicio Auth Service (Para Login en panel CMS)
VITE_AUTH_API_URL=http://localhost:8081/api/auth

# Supabase opcional directo si se requiere desde cliente
VITE_SUPABASE_URL=https://<TU-PROJECT-ID>.supabase.co
VITE_SUPABASE_ANON_KEY=<TU-ANON-KEY>

# Lectura CMS: activar tras validar la API pública; apagados por defecto.
VITE_CMS_HERO_PUBLICADO_ENABLED=false
VITE_CMS_HERO_PROMO_SLIDES_ENABLED=false
