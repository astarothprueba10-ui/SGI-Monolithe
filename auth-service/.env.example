# Supabase PostgreSQL Database Connection
# Nota: Puedes usar el Session Pooler (puerto 5432) o Transaction Pooler (puerto 6543) de Supabase
DB_URL=jdbc:postgresql://db.<TU-PROJECT-ID>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres.<TU-PROJECT-ID>
DB_PASSWORD=<TU-PASSWORD-DE-BASE-DE-DATOS>

# JWT Keys (RSA)
JWT_PRIVATE_KEY_PATH=/ruta/a/private_key.pem
JWT_PUBLIC_KEY_PATH=/ruta/a/public_key.pem

# Mail Configuration
MAIL_FROM=no-reply@monolithe.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=usuario@monolithe.com
MAIL_PASSWORD=password_aplicacion

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
