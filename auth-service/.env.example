# Supabase PostgreSQL Database Connection (Session Pooler puerto 5432 o Transaction Pooler 6543)
DB_URL=jdbc:postgresql://REDACTED_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.REDACTED_PROJECT_REF
DB_PASSWORD=<TU-PASSWORD-DE-BASE-DE-DATOS>

# JWT Keys (RSA)
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem

# Mail Configuration
MAIL_FROM=no-reply@monolithe.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dummy
MAIL_PASSWORD=dummy

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
